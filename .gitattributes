# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF (breaks in Linux containers otherwise)
*.sh text eol=lf

# Python source
*.py text eol=lf
*.pyi text eol=lf

# Config / data files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf

# Windows-specific scripts should keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - do not modify
*.pyc binary
*.pyd binary
*.dll binary
*.exe binary
*.so binary
*.pem binary